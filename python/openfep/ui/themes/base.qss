/* VS Code Modern workbench: native Vulkan surface stays outside Qt painting. */
QMainWindow, QDialog { background: @bg@; color: @text@; }
QWidget#treePanel, QWidget#propertyPanel, QWidget#commandBar,
QWidget#ribbonPage, QWidget#editorHeader { background: @panel@; }
QWidget#commandBar { border-bottom: 1px solid @border@; }
QWidget#editorHeader { border-bottom: 1px solid @border@; }
QWidget#ribbon, SARibbonBar, SARibbonCategory, SARibbonStackedWidget { background: @ribbon@; color: @text@; border: none; }
SARibbonStackedWidget { border-bottom: 1px solid @border@; }
SARibbonPanel, SARibbonButtonGroupWidget, SARibbonQuickAccessBar, SARibbonCtrlContainer { background: transparent; color: @text@; border: none; }
SARibbonPanelLabel { color: @text@; background: @group_title@; border: none; font-size: 11px; }
SARibbonSeparatorWidget { color: @border@; }
SARibbonApplicationButton { background: transparent; color: @text@; border: none; padding: 0; }
SARibbonApplicationButton:hover { background: @hover@; }
SARibbonApplicationButton::menu-indicator { width: 0; }
SARibbonSystemToolButton { color: @text@; background: transparent; border: none; padding: 0; }
SARibbonSystemToolButton:hover { background: @hover@; }
SARibbonSystemToolButton#SACloseWindowButton:hover { background: #C42B1C; }
SARibbonButtonGroupWidget > QToolButton { border: none; padding: 0 2px; }
QLabel { color: @text@; }
QLabel[role="muted"], QLabel#groupCaption { color: @muted@; }
QLabel[role="error"] { color: @error@; }
QLabel#brand { color: @text@; font-size: 13px; font-weight: 400; padding: 0 10px 0 0; }
QLabel#selectionTitle { font-size: 13px; font-weight: 600; padding: 6px 0; }
QLabel#editorTab { background: @bg@; border-top: 1px solid @accent@; border-right: 1px solid @border@; padding: 8px 18px; }
QLabel#breadcrumbs { color: @muted@; padding: 4px 12px; background: @bg@; }
QDockWidget { color: @text@; font-weight: 400; }
QDockWidget::title { background: @panel@; padding: 7px 12px; border-bottom: 1px solid @border@; }
QDockWidget::close-button, QDockWidget::float-button { border: none; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background: @hover@; }
QMainWindow::separator { background: @border@; width: 1px; height: 1px; }
QMainWindow::separator:hover { background: @accent@; }
QTreeWidget, QTableWidget, QListWidget, QPlainTextEdit, QTextEdit {
    background: @panel@; color: @text@; border: none;
    alternate-background-color: @panel@; selection-background-color: @selected@; selection-color: @text@;
}
QTreeWidget::item { height: @rowheight@px; padding: 0 4px; border: none; }
QTreeWidget::item:hover { background: @hover@; }
QTreeWidget::item:selected { background: @selected@; color: @text@; border-radius: 0; }
QTreeWidget::item:selected:focus { border: 1px solid @accent@; }
QTreeWidget::branch { background: @panel@; }
QTreeWidget::branch:selected { background: @selected@; }
QTreeWidget::branch:has-children:closed { image: url("@assets@/chevron-right-@variant@.svg"); }
QTreeWidget::branch:has-children:open { image: url("@assets@/chevron-down-@variant@.svg"); }
QTableWidget { gridline-color: @border@; }
QTableWidget::item { padding: 2px 4px; }
QHeaderView::section { background: @panel@; color: @muted@; padding: 5px 4px; border: none; border-bottom: 1px solid @border@; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: @input@; color: @text@; border: 1px solid @inputborder@; border-radius: 0;
    padding: 2px 6px; min-height: 20px; selection-background-color: @accent@; selection-color: #FFFFFF;
}
QLineEdit#commandSearch { background: @input@; border-radius: 4px; padding: 1px 8px; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid @accent@; }
QLineEdit:disabled, QComboBox:disabled { color: @disabled@; background: @panel@; }
QComboBox QAbstractItemView { background: @bg@; color: @text@; selection-background-color: @selected@; selection-color: @text@; }
QPushButton { background: @panel@; color: @text@; border: 1px solid @inputborder@; border-radius: 2px; padding: 4px 12px; }
QPushButton:hover:enabled { background: @hover@; }
QPushButton:pressed:enabled { background: @selected@; }
QPushButton:focus { border-color: @accent@; }
QPushButton:default { background: @accent@; color: #FFFFFF; border-color: @accent@; }
QPushButton:disabled { color: @disabled@; background: @panel@; }
QToolButton { color: @text@; background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 3px; }
QToolButton:hover:enabled { background: @hover@; }
QToolButton:pressed, QToolButton:checked { background: @selected@; }
QToolButton:focus { border-color: @accent@; }
QToolButton:disabled { color: @disabled@; }
QToolButton#fileButton { padding: 0; }
QToolButton#ribbonCommand { min-width: 54px; padding: 3px 6px; }
QTabBar#ribbonTabs::tab { background: @ribbon@; color: @muted@; padding: 0 13px; border-top: 2px solid transparent; }
QTabBar#ribbonTabs::tab:selected { color: @text@; background: @bg@; border-top-color: @accent@; }
QTabBar#ribbonTabs::tab:hover { background: @hover@; }
QFrame#ribbonGroup { border: none; border-right: 1px solid @border@; }
QLabel#groupCaption { font-size: 11px; padding-top: 1px; }
QScrollArea#ribbonScroll { border: none; background: @panel@; }
QScrollArea { border: none; }
QMenuBar { background: @panel@; color: @text@; }
QMenu { background: @bg@; color: @text@; border: 1px solid @inputborder@; padding: 4px; }
QMenu::item { padding: 5px 28px 5px 12px; border-radius: 2px; }
QMenu::item:selected { background: @accent@; color: #FFFFFF; }
QMenu::item:disabled { color: @disabled@; }
QMenu::separator { height: 1px; background: @border@; margin: 4px 8px; }
QStatusBar { background: @panel@; color: @text@; border-top: 1px solid @border@; font-size: 12px; }
QStatusBar::item { border: none; }
QStatusBar QLabel { font-size: 12px; padding: 0 8px; }
QLabel#statusMark { background: @accent@; color: #FFFFFF; padding: 2px 10px; }
QToolTip { background: @bg@; color: @text@; border: 1px solid @inputborder@; padding: 5px; }
QGroupBox { color: @text@; border: 1px solid @border@; border-radius: 0; margin-top: 12px; padding-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
QCheckBox, QRadioButton { color: @text@; spacing: 6px; }
QProgressBar { border: 1px solid @border@; border-radius: 0; background: @input@; text-align: center; color: @text@; }
QProgressBar::chunk { background: @accent@; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @scroll@; min-height: 30px; border-radius: 0; }
QScrollBar::handle:vertical:hover { background: @muted@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: @scroll@; min-width: 30px; border-radius: 0; }
QScrollBar::handle:horizontal:hover { background: @muted@; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
